# Copy to .env, then: docker compose up --build
JWT_SECRET=change-me-run-openssl-rand-hex-32
WEB_ORIGIN=http://localhost:8080
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_API_ORIGIN=http://localhost:4000
# Different registrable domains for web and api (e.g. mess.example.edu vs api.example.com)?
#   COOKIE_SAMESITE=None   (requires HTTPS; the cookie is then also marked Secure)
COOKIE_SAMESITE=Lax

# Deploying for real (HTTPS, backups, monitoring)? Use docker-compose.prod.yml and .env.prod.example — see docs/DEPLOYMENT.md.
