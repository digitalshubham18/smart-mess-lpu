PORT=4000
# TODO(production): generate a strong random secret and set it as a real env var — never
# ship the hardcoded dev fallback in server/src/auth.js to production.
JWT_SECRET=change-me-to-a-long-random-string
# The frontend origin allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Optional — leave unset to use the default "outbox" mailer (writes real .txt files to
# server/data/outbox/ instead of sending over the network; see server/src/email.js).
# Set these to send real emails (password resets, new-staff temp passwords) via SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@lpu.smartmess.edu

# Optional — database backups (npm run backup). Defaults shown.
# DB_PATH=./data/smartmess.sqlite
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# Behind a reverse proxy / load balancer? Number of proxy hops in front of this server (usually 1). Leave UNSET if
# clients connect directly — trusting X-Forwarded-For with no proxy lets anyone spoof their IP past the rate limiters.
# TRUST_PROXY=1
# Per-IP sign-in attempts allowed per 5 minutes (default 150; one campus/hostel often shares a single IP).
# LOGIN_RATE_MAX=150

# Email (see README § 6e-vii). Unset SMTP_HOST = mail is written to files in the outbox instead.
# SMTP_TIMEOUT_MS=8000        # fail fast if the mail server is down or unresponsive
# SMTP_REQUIRE_TLS=true       # refuse to send unencrypted — recommended in production
# Password hashing: native bcrypt is used when installed; BCRYPT_IMPL=js forces the slower pure-JS fallback.
# BCRYPT_IMPL=js

# Staff passwords expire after this many days and must be changed at next sign-in (default 90; 0 = never expire).
# PASSWORD_MAX_AGE_DAYS=90

# Web Push (notifications to phones/browsers; see README "Push notifications"). Unset = a key pair is generated on first boot and
# stored in the database. For production set your own (npx web-push generate-vapid-keys) — changing them later orphans every
# existing subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-university.edu

# --- v11 ---------------------------------------------------------------------------------------------------------
# Roles that MUST use two-factor sign-in. Unset = SUPER_ADMIN,ADMIN. Empty = off (local development only).
# REQUIRE_2FA_ROLES=SUPER_ADMIN,ADMIN
# Who students should contact about their data (shown in the photo privacy notice).
PRIVACY_CONTACT_EMAIL=privacy@example.edu
# Background jobs (one process): 9 PM meal reminder, automatic no-shows, daily clean-up. SCHEDULER=0 turns all off.
# REMINDER_TIME=21:00
# REMINDERS=0
# AUTO_NO_SHOWS=0                # default for messes that haven't chosen (each mess can switch it in the app)
# AUTO_NOSHOW_GRACE_MIN=30       # minutes after a meal window closes before no-shows are processed
# NO_SHOW_FINE_AMOUNT=100        # default fine for 3 warnings in a month
# BACKUP_MAX_AGE_HOURS=36        # /api/health/ready goes 503 if the newest backup is older than this
# BACKUP_CHECK=0                 # ...or if you really have no backups yet and want ready=200 anyway (not recommended)
# SCHEDULER=0
# SEED_DEMO=0                    # production: hostels/messes only, NO demo people; then: node scripts/create-super-admin.js
# SUMMARY_TIME=22:30             # end-of-day manager summary (DAILY_SUMMARY=0 turns it off)
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...   # optional: told about each NEW kind of error
# AUTO_NOSHOW_MIN_SCAN_RATIO=0.3 # skip automatic no-shows if fewer than this share of "will eat" students were scanned
