# Security headers for the FRONTEND's own HTML (the API only serves JSON, so it can't set these for it).
server {
  listen 8080;
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;

  include /etc/nginx/conf.d/security-headers.inc;

  # Never serve dotfiles (.env, .git, …) even if one ever ends up in the web root.
  location ~ /\. { return 404; }

  # Hashed build assets can be cached forever; index.html must always be revalidated.
  location /assets/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }
  location = /index.html {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache" always;
  }
  # The service worker must always be revalidated — a stale copy would keep serving an old app shell.
  location = /sw.js {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache" always;
    add_header Service-Worker-Allowed "/" always;
  }
  # SPA: any other path is a client-side route (inherits the server-level headers — it adds none of its own).
  location / { try_files $uri /index.html; }
}
