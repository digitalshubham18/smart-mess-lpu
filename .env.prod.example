# Copy to .env for:  docker compose -f docker-compose.prod.yml up -d --build   (docs/DEPLOYMENT.md has the full walkthrough)

# The public hostname people type. DNS must already point at this server; ports 80 and 443 must be open.
SITE_ADDRESS=mess.example.edu

# Signs every login. openssl rand -hex 32 — keep it secret, and note: changing it signs everyone out.
JWT_SECRET=

# Shown to students in the photo privacy notice as the person/office to contact about their data.
PRIVACY_CONTACT_EMAIL=privacy@example.edu

# --- Optional -------------------------------------------------------------------------------------------------------
# Real email (otherwise mail is only written to files). Real push notifications need VAPID keys: cd server && npx web-push generate-vapid-keys
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@example.edu

# Roles that must use two-factor sign-in. Leave this line OUT to keep the default (SUPER_ADMIN,ADMIN). An empty value turns it off — don't, in production.
# REQUIRE_2FA_ROLES=SUPER_ADMIN,ADMIN
REMINDER_TIME=21:00
# End-of-day summary push/email to each mess's manager and admin (mess time). DAILY_SUMMARY=0 turns it off.
SUMMARY_TIME=22:30
# Optional: post NEW kinds of errors to a chat (Slack/Teams incoming webhook, https only; max 10 messages an hour).
ERROR_WEBHOOK_URL=
NO_SHOW_FINE_AMOUNT=100
MESS_TIMEZONE=Asia/Kolkata
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
